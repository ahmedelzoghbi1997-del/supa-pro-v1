# ==============================================================================
# Environment Variables Example Template
# Duplicate this file as .env and fill in your actual credentials.
# Never commit real API keys or secrets to version control.
# ==============================================================================

# Supabase Configuration (Frontend - Public Anon Access)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_public_key_here

# Supabase Configuration (Backend / Server - Privileged Access)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# Push Notifications Internal Secret (المفتاح السري الداخلي لإرسال الإشعارات - يجب تعيينه بنفس القيمة في Vercel وفي بيئة السيرفر)
PUSH_INTERNAL_SECRET=your_push_internal_secret_here

# Web Push VAPID Keys (إعدادات مفاتيح إشعارات الويب)
VAPID_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

